<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.food.api.dao.BannerDao">

    <select id="findList" parameterType="com.food.api.dto.BannerDTO" resultType="com.food.api.dto.BannerDTO">
        select *
        from banner dishType
        <where>
            <if test="id != null and id != ''">and dishType.id = #{id}</if>
            <if test="createTime != null and createTime != ''">and dishType.create_time = #{createTime}</if>
        </where>
        <if test="current != null and pageSize != null">
            limit #{current},#{pageSize}
        </if>
    </select>

    <select id="findPageCount" parameterType="com.food.api.dto.BannerDTO" resultType="java.lang.Integer">
        select count(*) from banner dishType
        <where>
            <if test="id != null and id != ''">and dishType.id = #{id}</if>
            <if test="createTime != null and createTime != ''">and dishType.create_time = #{createTime}</if>
        </where>
    </select>

</mapper>
